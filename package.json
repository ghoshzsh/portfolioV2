{
  "name": "v1",
  "description": "Personal Website V2",
  "version": "1.0.0",
  "author": "Aniruddha Ghosh",
  "repository": {
    "type": "git",
    "url": "https://github.com/aghosh0605/portfolioV2"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "MIT",
  "scripts": {
    "build": "export SET NODE_OPTIONS=--openssl-legacy-provider && gatsby build",
    "develop": "gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "start": "export SET NODE_OPTIONS=--openssl-legacy-provider && npm run develop",
    "serve": "export SET NODE_OPTIONS=--openssl-legacy-provider && gatsby serve",
    "clean": "gatsby clean",
    "gpdeploy": "export SET NODE_OPTIONS=--openssl-legacy-provider && gatsby build && gh-pages -d public -b main",
    "deploy": "gatsby clean && export SET NODE_OPTIONS=--openssl-legacy-provider && gatsby build && gatsby serve"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,css,json,md}": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "animejs": "^3.1.0",
    "babel-plugin-styled-components": "^2",
    "gatsby": "^5",
    "gatsby-plugin-google-gtag": "5.15.0",
    "gatsby-plugin-image": "^3",
    "gatsby-plugin-manifest": "^5",
    "gatsby-plugin-netlify": "^5",
    "gatsby-plugin-offline": "^6",
    "gatsby-plugin-react-helmet": "^6",
    "gatsby-plugin-robots-txt": "^1.5.0",
    "gatsby-plugin-sharp": "^5",
    "gatsby-plugin-sitemap": "^6",
    "gatsby-plugin-styled-components": "^6",
    "gatsby-remark-external-links": "0.0.4",
    "gatsby-remark-images": "^7",
    "gatsby-remark-prismjs": "^7",
    "gatsby-source-filesystem": "^5",
    "gatsby-transformer-remark": "^6",
    "gatsby-transformer-sharp": "^5",
    "lodash": "^4.17.15",
    "prismjs": "^1.17.1",
    "prop-types": "^15.7.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-helmet": "^5.2.1",
    "react-transition-group": "^4.3.0",
    "scrollreveal": "^4.0.5",
    "sharp": "^0.34.3",
    "smooth-scroll": "^16.1.0",
    "styled-components": "^6"
  },
  "devDependencies": {
    "@upstatement/eslint-config": "0.4.3",
    "@upstatement/prettier-config": "^0.3.0",
    "babel-eslint": "^10.1.0",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-react": "^7.19.0",
    "gatsby-remark-code-titles": "^1.1.0",
    "gh-pages": "^3.2.3",
    "husky": "^4.2.3",
    "lint-staged": "^10.1.2",
    "prettier": "^2.0.4"
  }
}
